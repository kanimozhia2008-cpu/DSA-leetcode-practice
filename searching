704.BINARY SEARCH:(EASY)
int left = 0;
int right = nums.length - 1;
while (left <= right) {
    int mid = left + (right - left) / 2;
    if (nums[mid] == target) {
        return mid;
    } 
    else if (nums[mid] < target) {
        left = mid + 1;
    } 
    else {
        right = mid - 1;
    }
}
return -1;
35.SEARCH INSERT POSITION:(EASY)
class Solution {
    public int searchInsert(int[] nums, int target) {
     int st=0;
     int end=nums.length-1; 
      while(st<=end){
        int mid=st+(end-st)/2;
        if(target==nums[mid]){
            return mid;
        }
        else if(nums[mid]<target){
            st=mid+1;
        }
        else {
            end=mid-1;      
        }
      }
      return st;
    }
}
35.SQRT(X):(EASY)
     class Solution {
    public int mySqrt(int x) {
        int left=0;
        int right=x;
        int ans=0;
        while(left<=right){
           int mid = left + (right - left) / 2;
            if((long)mid*mid==x){
                return mid;
            }
            else if((long)mid*mid<x){
                ans=mid;
                left=mid+1;
            }
            else{
                right=mid-1;
            }

        }
        return ans;
    }
}
